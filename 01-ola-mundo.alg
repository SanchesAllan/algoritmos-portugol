// =========================================================================
// ENUNCIADO: 
// Escreva um programa que mostre na tela a mensagem "Olá, Mundo!
// =========================================================================

algoritmo "ola-mundo" 
var
 msg:caractere
inicio
 msg<-"Olá Mundo"
 escreval(msg)
 escreva("Saltou para a linha de baixo")
fimalgoritmo
