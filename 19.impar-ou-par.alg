algoritmo "impar-ou-par"
// Função :
// Autor :
// Data : 02/02/2026
// Seção de Declarações
var
numero: inteiro
inicio
escreval("Digite um número")
leia(numero)
se numero%2=0 entao
   escreva("O número",numero, " é par!")
senao
   escreva("O número",numero, " é ímpar!")
fimse
// Seção de Comandos
fimalgoritmo
